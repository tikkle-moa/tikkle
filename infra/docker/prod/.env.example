# 운영 서버에 .env로 복사해 사용합니다.
# GHCR 이미지 경로에 사용할 소문자 owner/repository
GITHUB_REPOSITORY=your-owner/tikkle
IMAGE_TAG=latest

# 실제 서비스 도메인과 Let's Encrypt 인증서 디렉터리 이름
DOMAIN_NAME=tikkle.example.com
CERTIFICATE_NAME=tikkle.example.com

# -----------------------------------------------
# Server
# -----------------------------------------------
APP_PRODUCTION=true
SERVER_BASE_URL=https://${DOMAIN_NAME}
FRONTEND_URL=https://${DOMAIN_NAME}

# -----------------------------------------------
# Database (MySQL)
# ex) jdbc:mysql://localhost:3306/tikkle?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# -----------------------------------------------
MYSQL_DATABASE=tikkle
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------
# Redis
# -----------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------
# Swagger
# -----------------------------------------------
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# -----------------------------------------------
# Springwolf AsyncAPI 문서
# -----------------------------------------------
SPRINGWOLF_ENABLED=false

# -----------------------------------------------
# OAuth
# -----------------------------------------------
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------
# JWT
# -----------------------------------------------
JWT_SECRET=
