{
  "name": "tikkle",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "prepare": "husky",
    "dev:client": "pnpm -F client dev",
    "dev:server": "cd apps/server && ./gradlew bootRun",
    "build:client": "pnpm -F client build",
    "build:server": "cd apps/server && ./gradlew bootJar",
    "build": "pnpm build:client && pnpm build:server",
    "lint": "pnpm -F client lint",
    "lint:fix": "pnpm -F client lint:fix",
    "format:client": "pnpm -F client format",
    "format:client:write": "pnpm -F client format:write",
    "format:server": "cd apps/server && ./gradlew ktlintCheck",
    "format:server:write": "cd apps/server && ./gradlew ktlintFormat",
    "format": "pnpm format:client && pnpm format:server",
    "format:write": "pnpm format:client:write && pnpm format:server:write",
    "lint-staged": "lint-staged --no-revert",
    "test:client": "pnpm -F client test",
    "test:client:coverage": "pnpm -F client test:coverage",
    "test:server": "cd apps/server && ./gradlew test --console=plain --quiet",
    "test:server:rerun": "cd apps/server && ./gradlew test --rerun-tasks --console=plain --quiet",
    "test:e2e:report": "pnpm -F client test:e2e:report",
    "docker:test:e2e": "node infra/docker/e2e/docker-test-e2e.mjs",
    "docker:build:client": "bash infra/docker/prod/build-image.sh client",
    "docker:build:server": "bash infra/docker/prod/build-image.sh server",
    "docker:build": "pnpm docker:build:client && pnpm docker:build:server",
    "api:open": "pnpm -F @tikkle/api-types generate:openapi",
    "api:async": "pnpm -F @tikkle/api-types generate:asyncapi",
    "api:types": "pnpm api:open && pnpm api:async"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
