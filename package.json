{
  "name": "tikkle",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev:client": "pnpm -F client dev",
    "dev:server": "cd apps/server && ./gradlew bootRun",
    "test:client": "pnpm -F client test",
    "test:client:coverage": "pnpm -F client test:coverage",
    "test:server": "cd apps/server && ./gradlew test --console=plain --quiet",
    "test:server:rerun": "cd apps/server && ./gradlew test --rerun-tasks --console=plain --quiet",
    "prepare": "husky",
    "lint-staged": "lint-staged --no-revert",
    "format:client": "pnpm -F client format",
    "format:server": "cd apps/server && ./gradlew ktlintFormat",
    "format": "pnpm format:client && pnpm format:server",
    "format:check:client": "pnpm -F client format:check",
    "format:check:server": "cd apps/server && ./gradlew ktlintCheck",
    "format:check": "pnpm format:check:client && pnpm format:check:server",
    "docker": "docker compose -f infra/docker/docker-compose.dev.yaml",
    "docker:up": "docker compose -f infra/docker/docker-compose.dev.yaml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.dev.yaml down",
    "docker:ps": "docker compose -f infra/docker/docker-compose.dev.yaml ps",
    "docker:logs": "docker compose -f infra/docker/docker-compose.dev.yaml logs -f",
    "docker:test:e2e": "node infra/docker/docker-test-e2e.mjs",
    "test:e2e": "pnpm -F client test:e2e",
    "test:e2e:report": "pnpm -F client test:e2e:report",
    "api:open": "pnpm -F @tikkle/api-types generate:openapi",
    "api:async": "pnpm -F @tikkle/api-types generate:asyncapi",
    "api:types": "pnpm api:open && pnpm api:async"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
