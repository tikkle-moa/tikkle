{
  "name": "@tikkle/api-types",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate:openapi": "openapi-typescript --redocly ./redocly.yaml && prettier --write src/generated.ts",
    "generate:asyncapi": "node generate-asyncapi-types.mjs && prettier --write src/stomp.generated.ts",
    "generate": "pnpm generate:openapi && pnpm generate:asyncapi",
    "validate:asyncapi": "node generate-asyncapi-types.mjs --check && prettier --check src/stomp.generated.ts"
  },
  "devDependencies": {
    "@asyncapi/modelina": "5.10.1",
    "@asyncapi/parser": "3.6.3",
    "openapi-typescript": "^7.13.0"
  }
}
